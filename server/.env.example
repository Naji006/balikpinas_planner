PORT=3000
APP_ORIGINS=http://localhost:4200,http://localhost:8100,https://localhost,capacitor://localhost
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=balikpinas_planner

# Public frontend origin. Use HTTPS and COOKIE_SECURE=true in production.
APP_URL=http://localhost:4200
# Use a stable random secret (at least 32 bytes) across API instances for signed Google flow cookies.
AUTH_FLOW_SECRET=
# Resend: verify your sending domain, then set an API key and sender address.
RESEND_API_KEY=
EMAIL_FROM=
# Google Cloud OAuth client type: Web application. Keep the client secret on the server.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Register this exact URI in Google Cloud; leave blank to use APP_URL/api/auth/google/callback.
GOOGLE_REDIRECT_URI=
